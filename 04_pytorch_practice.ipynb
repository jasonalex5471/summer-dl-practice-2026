      "tensor([0., 0., 0., 0.])\n"
     ]
    }
   ],
   "source": [
    "import torch\n",
    "\n",
    "#自动微分\n",
    "\n",
    "x = torch.arange(4.0)\n",
    "print(x)\n",
    "print(x.shape)\n",
    "\n",
    "x.requires_grad_(True)\n",
    "print(x.grad)\n",
    "\n",
    "y = 2 * torch.dot(x, x)\n",
    "\n",
    "print(y)\n",
    "print(y.shape)\n",
    "\n",
    "y.backward()\n",
    "print(x.grad)\n",
    "\n",
    "print(x.grad == 4 * x)\n",
    "\n",
    "x.grad.zero_()  #pytorch默认情况会自动累计梯度\n",
    "y = x.sum()\n",
    "y.backward\n",
    "print(x.grad)"
   ]
  }
 ],
